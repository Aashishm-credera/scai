{
  "name": "content-sdk-nextjs-app-router-cache-components",
  "description": "Content SDK Next.js App Router sample with Cache Components and On-demand revalidation",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Sitecore Corporation",
    "url": "https://doc.sitecore.com/sai/en/developers/content-sdk/sitecore-content-sdk-for-sitecoreai.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitecore/content-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/sitecore/content-sdk/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "cross-env NODE_ENV=production npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build next:build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "npm-run-all --serial lint:fix format",
    "verify": "npm-run-all --serial lint format:check test test:storybook tokens:check icons:check build-storybook",
    "next:build": "next build",
    "next:dev": "cross-env NODE_OPTIONS='--inspect' next dev",
    "next:start": "next start",
    "sitecore-tools:generate-map": "sitecore-tools project component generate-map",
    "sitecore-tools:generate-map:watch": "sitecore-tools project component generate-map --watch",
    "sitecore-tools:build": "sitecore-tools project build",
    "sitecore-tools:build:offline": "sitecore-tools project build --config sitecore.cli.offline.config.ts",
    "dev": "cross-env NODE_ENV=development npm-run-all --serial sitecore-tools:generate-map sitecore-tools:build --parallel next:dev sitecore-tools:generate-map:watch",
    "start": "cross-env-shell NODE_ENV=production npm-run-all --serial build next:start",
    "tokens:validate": "node design-tokens/scripts/validate-cli.mjs",
    "tokens:generate": "node design-tokens/scripts/generate.mjs --strict --pinned",
    "tokens:build": "npm-run-all --serial tokens:validate tokens:generate",
    "tokens:test": "node --test design-tokens/tests/*.test.mjs",
    "tokens:check": "npm-run-all --serial tokens:test tokens:build",
    "tokens:breaking": "node design-tokens/scripts/generate.mjs --strict --pinned --fail-on-breaking",
    "tokens:baseline": "node design-tokens/scripts/generate.mjs --strict --pinned --pin",
    "icons:build": "node design-tokens/scripts/icons.mjs",
    "icons:check": "node design-tokens/scripts/icons.mjs --check",
    "pretype-check": "node scripts/clean-next-types.mjs",
    "type-check": "next typegen && tsc --noEmit",
    "typecheck": "npm run type-check",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "playwright:install": "playwright install --with-deps chromium",
    "storybook": "npm-run-all --serial tokens:build storybook:dev",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "npm-run-all --serial tokens:build storybook:build",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@dataweavers/arc-core": "^1.8.6",
    "@dataweavers/redis-page-caching": "^2.8.6",
    "@dataweavers/spark-nextjs": "^1.0.75",
    "@sitecore-content-sdk/analytics-core": "^2.1.2",
    "@sitecore-content-sdk/events": "^2.1.2",
    "@sitecore-content-sdk/nextjs": "^2.4.0",
    "@sitecore-content-sdk/personalize": "^2.1.0",
    "@sitecore-feaas/clientside": "^0.6.0",
    "@sitecore/components": "~2.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "next": "^16.2.0",
    "next-intl": "^4.3.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@eslint/eslintrc": "^3",
    "@sitecore-content-sdk/cli": "^2.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "^10.6.0",
    "npm-run-all2": "^8.0.4",
    "playwright": "latest",
    "prettier": "^3.9.9",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
